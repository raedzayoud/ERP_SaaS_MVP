# Copy this file to `.env` and fill in real values.
# `.env` is ignored by Git; never commit real secrets.

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

STRIPE_SUCCESS_URL=http://localhost:4200/signup/success
STRIPE_CANCEL_URL=http://localhost:4200/signup/payment-cancelled
STRIPE_PORTAL_RETURN_URL=http://localhost:4200/settings/billing

STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_STARTER_ANNUAL=price_...
STRIPE_PRICE_BUSINESS_MONTHLY=price_...
STRIPE_PRICE_BUSINESS_ANNUAL=price_...
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_...
STRIPE_PRICE_ENTERPRISE_ANNUAL=price_...

# Where the customer lands after buying a module.
STRIPE_MODULE_SUCCESS_URL=http://localhost:4200/settings?tab=modules
STRIPE_MODULE_CANCEL_URL=http://localhost:4200/settings?tab=modules

# One recurring monthly price per module a workspace can buy on top of its
# plan. The monthly price shown to the customer is in application.properties
# (app.module.prices.<module>). A module without a price id is not for sale.
STRIPE_PRICE_MODULE_STOCK=price_...
STRIPE_PRICE_MODULE_PURCHASES=price_...
STRIPE_PRICE_MODULE_ACCOUNTING=price_...
STRIPE_PRICE_MODULE_REPORTS=price_...
STRIPE_PRICE_MODULE_HR=price_...
STRIPE_PRICE_MODULE_SUPPORT=price_...
STRIPE_PRICE_MODULE_MARKETING=price_...
STRIPE_PRICE_MODULE_AI_ASSISTANT=price_...
STRIPE_PRICE_MODULE_ROOM_LIVE=price_...

# Password reset emails (Gmail SMTP example)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-address@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=your-address@gmail.com
